# Copy to .env before running `docker compose up` directly.
#
# NOTE: when using start-infra.sh, you don't need to (and shouldn't) fill in
# any of the database/redis/mongo credentials below by hand: that script
# calls fetch_secrets_to_environment (lib-infra.sh) which pulls all of them
# straight from AWS Secrets Manager and exports them into the shell
# environment before running `docker compose up`. All you need to provide
# are your AWS credentials:

# --- AWS credentials, required by start-infra.sh (to read the secrets from
#     AWS Secrets Manager) and by the Java services, which additionally
#     import their own configuration from AWS Secrets Manager at startup
#     (spring.config.import: aws-secretsmanager:...) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# =====================================================================
# Everything below is OPTIONAL: docker-compose.yml already falls back to
# sane defaults for local use if left unset. Override only if needed
# (e.g. for a real NODE_AUTH_TOKEN to build conference-web-api, or real
# SMTP credentials for notification-manager to actually send emails).
# Required before `docker compose build` for the three Java services (see
# their own repos' Dockerfile for details):
#   mvn -pl account-manager-app -am package -DskipTests      (in ../account-manager)
#   mvn -pl conference-manager-app -am package -DskipTests   (in ../conference-manager)
#   mvn -pl notification-manager-app -am package -DskipTests (in ../notification-manager)
# =====================================================================

# --- conference-web-api (GitHub Packages, build-time only, used to
#     resolve the private @bycrafter/*-grpc-contract npm packages) ---
# Like the kafka service (which listens on both the internal docker network
# and localhost), each of the 5 app repos should stay reachable both from
# other containers AND from localhost, so any of them can be stopped here
# and run instead from your IDE (for debugging) without breaking the rest.
# account-manager/conference-manager already expose their gRPC ports to
# localhost (6065/6075), so conference-web-api can only reach them by
# container name by default. If you stop one of them and run it locally
# instead, override the corresponding URL below to point at
# "host.docker.internal:<port>" (conference-web-api already declares the
# required extra_hosts entry for this to work):
ACCOUNT_MANAGER_GRPC_URL=account-manager:6065
CONFERENCE_MANAGER_GRPC_URL=conference-manager:6075
NODE_AUTH_TOKEN=
GRPC_TIMEOUT_MS=5000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# --- conference-web-app (baked into the Vite build at build time) ---
VITE_API_BASE_URL=/v1

# --- shared ---
FRONTEND_URL=http://localhost:5173